{
  "name": "playwright-projects",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test": "node --loader ts-node/esm node_modules/@cucumber/cucumber/bin/cucumber-js",
    "report:generate": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report",
    "report": "npm run report:generate && npm run report:open"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.8.2",
    "@playwright/test": "^1.49.0",
    "allure-cucumberjs": "^3.7.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  }
}

